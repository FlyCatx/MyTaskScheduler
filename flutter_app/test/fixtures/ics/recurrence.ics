BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//TaskScheduler//Round2 Recurrence//CN
BEGIN:VEVENT
UID:rec-daily@example.test
DTSTAMP:20260101T000000Z
DTSTART;TZID=Asia/Shanghai:20260302T090000
DTEND;TZID=Asia/Shanghai:20260302T093000
RRULE:FREQ=DAILY;COUNT=3
SUMMARY:每日站会
END:VEVENT
BEGIN:VEVENT
UID:rec-weekly@example.test
DTSTAMP:20260101T000000Z
DTSTART;TZID=Asia/Shanghai:20260302T100000
DTEND;TZID=Asia/Shanghai:20260302T110000
RRULE:FREQ=WEEKLY;BYDAY=MO,WE,FR;COUNT=4
SUMMARY:每周一三五
END:VEVENT
BEGIN:VEVENT
UID:rec-monthly@example.test
DTSTAMP:20260101T000000Z
DTSTART;TZID=Asia/Shanghai:20260302T140000
DTEND;TZID=Asia/Shanghai:20260302T150000
RRULE:FREQ=MONTHLY;BYDAY=1MO;COUNT=3
SUMMARY:每月第一个周一
END:VEVENT
BEGIN:VEVENT
UID:rec-yearly@example.test
DTSTAMP:20260101T000000Z
DTSTART;TZID=Asia/Shanghai:20260302T150000
DTEND;TZID=Asia/Shanghai:20260302T160000
RRULE:FREQ=YEARLY;COUNT=2
SUMMARY:每年纪念日
END:VEVENT
BEGIN:VEVENT
UID:rec-last-weekday@example.test
DTSTAMP:20260101T000000Z
DTSTART;TZID=Asia/Shanghai:20260130T160000
DTEND;TZID=Asia/Shanghai:20260130T170000
RRULE:FREQ=MONTHLY;BYDAY=MO,TU,WE,TH,FR;BYSETPOS=-1;COUNT=3
SUMMARY:每月最后一个工作日
END:VEVENT
BEGIN:VEVENT
UID:rec-biweekly@example.test
DTSTAMP:20260101T000000Z
DTSTART;TZID=Asia/Shanghai:20260302T180000
DTEND;TZID=Asia/Shanghai:20260302T183000
RRULE:FREQ=WEEKLY;INTERVAL=2;COUNT=3
SUMMARY:隔周碰头
END:VEVENT
BEGIN:VEVENT
UID:rec-until-utc@example.test
DTSTAMP:20260101T000000Z
DTSTART;TZID=Asia/Shanghai:20260302T200000
DTEND;TZID=Asia/Shanghai:20260302T203000
RRULE:FREQ=DAILY;UNTIL=20260304T120000Z
SUMMARY:UTC UNTIL 的每日事件
END:VEVENT
BEGIN:VEVENT
UID:rec-allday-until@example.test
DTSTAMP:20260101T000000Z
DTSTART;VALUE=DATE:20260305
RRULE:FREQ=DAILY;UNTIL=20260307
SUMMARY:纯日期 UNTIL 的全天事件
END:VEVENT
END:VCALENDAR
