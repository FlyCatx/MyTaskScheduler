<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows compatibility manifest for the TaskScheduler OCR host.

  Without supportedOS declarations a .NET Framework process is treated as
  Windows 8 compatible, so Environment.OSVersion reports 6.2.9200 instead of the
  real Windows 10/11 build. The OCR engine identity string (and therefore the
  OCR cache key) must reflect the actual OS build, so the manifest is required.

  Deliberately no DPI-awareness setting: this is a batch tool with no UI, and the
  PDF renderer's rasterisation scale is measured at runtime instead of assumed.
  asInvoker only: the helper never needs elevation and must not ask for it.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="TaskScheduler.OcrHost" type="win32" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
    </application>
  </compatibility>
</assembly>
